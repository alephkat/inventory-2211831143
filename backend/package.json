{
  "name": "inventory-backend",
  "version": "1.0.0",
  "description": "Production-grade Mobile Inventory Management System - Backend API (Node.js + Express + Prisma + PostgreSQL)",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node src/seed.js",
    "bootstrap": "node scripts/bootstrap.js",
    "lint": "eslint src tests scripts --ext js",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "http-status": "^1.0.7",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true
  }
}