# Backend environment configuration for the Stockwise web app.
#
#   Copy-Item .env.example .env      # PowerShell
#   cp .env.example .env             # macOS / Linux
#
# `.env` is gitignored and must never be committed.

# Application
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
#
#   Local install (default):
#     postgresql://postgres:postgres@localhost:5432/inventory
#
#   Any managed/cloud Postgres also works (Neon, Supabase, RDS, Railway...):
#     postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
#
# On Windows, if the password contains special characters (@ : / ? #) it must
# be percent-encoded, otherwise the URL is parsed incorrectly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory

# JWT. Generate independent values of at least 32 characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two must differ; reusing one key for both lets an access token be used
# as a refresh token.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# CORS: comma-separated allowlist of permitted frontend origins.
# Vite dev server default is 5173; adjust if you change the port in vite.config.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Default admin password. Used by seed to create/update the admin user.
# CHANGE THIS IN PRODUCTION!
ADMIN_DEFAULT_PASSWORD=