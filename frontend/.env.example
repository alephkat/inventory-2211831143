# Frontend environment configuration for the Stockwise web app.
#
#   Copy-Item .env.example .env      # PowerShell
#   cp .env.example .env             # macOS / Linux
#
# `.env` is gitignored and must never be committed.

# Base URL of the backend API. Only variables prefixed with VITE_ are
# statically embedded into the build by Vite.
#
# Leave empty when the backend serves the frontend from the same origin
# (e.g. Render production). The API client then uses relative URLs.
#
# In development, Vite proxies /api to the backend (see vite.config.ts)
# so this can also be left empty.
#
# Set this to the backend's public URL only when the frontend and backend
# are served from different origins, e.g.:
#   VITE_API_URL=http://localhost:4000
#   VITE_API_URL=https://api.inventory.example.com
VITE_API_URL=
